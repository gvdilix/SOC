# ── Gadilix SOC Platform — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values

# Flask secret key (change this!)
SECRET_KEY=gadilix_change_this_secret_key_2024

# JWT secret (change this!)
JWT_SECRET_KEY=gadilix_jwt_secret_2024

# AbuseIPDB API key — Get free at https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=your_abuseipdb_api_key_here

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# Debug mode (set to False in production)
DEBUG=True

# Redis Queue (optional — for scalability with 100+ agents)
# Install Redis: https://redis.io/download
# Default: uses in-memory queue (no Redis needed for development)
REDIS_URL=redis://localhost:6379/0
